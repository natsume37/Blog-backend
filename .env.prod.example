APP_NAME=Blog-Backend
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

HOST=0.0.0.0
PORT=8090
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/blog
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=180

WEREAD_API_KEY=
WEREAD_SYNC_ENABLED=true
WEREAD_SYNC_INTERVAL_MINUTES=30
WEREAD_SKILL_VERSION=1.0.3

SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_BASE_URL=https://martin88.xyz
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://martin88.xyz/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email

CORS_ORIGINS=["https://martin88.xyz","https://www.martin88.xyz"]
ENABLE_REFERER_CHECK=true

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=example@qq.com
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=example@qq.com
EMAILS_FROM_NAME=Blog Bot

AI_ENABLED=true
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30

GEOIP_ENABLED=true
GEOIP_PROVIDER_URL=https://api.ip2location.io/?ip={ip}
